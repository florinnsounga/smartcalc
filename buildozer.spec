[app]

# Nom affiché sous l'icône de l'application sur le telephone
title = SmartCalc By Florin Pro

# Nom technique du package (pas d'espaces, pas d'accents)
package.name = smartcalc
package.domain = org.florinpro

# Dossier source (le dossier qui contient main.py)
source.dir = .
source.include_exts = py,png,jpg,kv,atlas

# Version de ton application
version = 1.0

# Dependances necessaires
requirements = python3,kivy

# Orientation de l'ecran
orientation = portrait

# Empeche la mise en veille pendant l'utilisation (optionnel)
fullscreen = 0

[buildozer]

# Niveau de log (2 = verbeux, utile pour voir les erreurs)
log_level = 2

# Ne pas demander confirmation avant de compiler
warn_on_root = 1




